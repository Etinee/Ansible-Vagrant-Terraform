# =========================================================
# Visual Studio Code
# =========================================================
# On ignore les réglages perso, mais on garde ceux utiles à tout le projet
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.code-workspace
*.vsix

# =========================================================
# Terraform
# =========================================================
# Plugins des providers téléchargés par `terraform init`
**/.terraform/*

# Fichiers d'état : contiennent souvent des secrets (mots de passe, IP, tokens)
*.tfstate
*.tfstate.*

# Logs de crash
crash.log
crash.*.log

# Variables : contiennent souvent des secrets
# (garde un exemple versionné, ex. terraform.tfvars.example)
*.tfvars
*.tfvars.json

# Surcharges locales
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plans générés par `terraform plan -out=...`
*.tfplan

# CLI config locale
.terraformrc
terraform.rc

# NB : .terraform.lock.hcl doit être versionné (verrouille les versions des providers)

# =========================================================
# Ansible
# =========================================================
*.retry
.ansible/
# Fichiers de mot de passe du vault (ne jamais les commiter)
.vault_pass
.vault_pass.txt
*.vault_pass
vault_password*
# Rôles et collections installés via `ansible-galaxy install -r requirements.yml -p ...`
# (décommente si tu les installes dans le projet)
# ansible/roles/
# ansible/collections/

# =========================================================
# Vagrant
# =========================================================
# État des VM + clé SSH privée générée par Vagrant
.vagrant/
*.box
# Log console créé par les box Ubuntu cloud
*-cloudimg-console.log

# =========================================================
# Divers / système
# =========================================================
*.log
.env
*.pem
*.key
id_rsa*
id_ed25519*
*.swp
*~
.DS_Store
Thumbs.db
